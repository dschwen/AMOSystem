<?xml version="1.0" encoding="utf-8"?>
<!-- The SignPath artifact configuration of the Windows release (paste it into the SignPath project;
     .github/workflows/windows-msi.yml submits the GitHub artifact "release-msi", a ZIP holding the
     one MSI). Inside the MSI, amos.exe and amos-player.exe are signed, then the MSI itself. SDL2.dll
     is libsdl.org's binary, not built here, and stays as it is. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <msi-file path="amos-*-windows-x64.msi">
      <pe-file path="**/amos.exe">
        <authenticode-sign />
      </pe-file>
      <pe-file path="**/amos-player.exe">
        <authenticode-sign />
      </pe-file>
      <authenticode-sign />
    </msi-file>
  </zip-file>
</artifact-configuration>
