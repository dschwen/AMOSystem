# Auto detect text files and perform LF normalization
* text=auto

# AMOS output, compared byte for byte (AMOS writes CR/LF line ends)
tests/golden/** binary
tests/host_only/**/*.txt binary

# Raw data (fonts...)
data/**/*.bin binary

# Files of the host tests that AMOS reads with CR/LF line ends
tests/host_only/adf.files/** binary

# Games bundled as examples: their data as it was (CR/LF text, raw banks)
examples/Examples/Games/** binary
