For F#=0.5 To 2 Step 0.5 : Print #1,F#; : Next F# : Print #1,""
For F#=1 To 0 Step -0.25 : Print #1,F#; : Next F# : Print #1,""
For I=1 To 0 : Print #1,"never" : Next I : Print #1,"empty";I
L$="lbl2" : Goto L$
LBL1: Print #1,"wrong"
LBL2: Print #1,"string label"
N=10 : Gosub N+10
Print #1,"back"
On 3 Proc PA,PB,PC
On 0 Gosub 20,20
On 5 Goto LBL1
Trap Error 23 : Print #1,"trap";Errtrap
Trap Print #1,"no error" : Print #1,Errtrap
Gosub ZPOPR
ZBACK: Print #1,"after pop"
On Error Proc EHANDLER
Error 25
Print #1,"after proc handler"
On Error Goto RETRY
CNT=0 : Error 26 : Print #1,"retried";CNT
On Error Goto SKIP
Error 27 : Print #1,"not here"
ZRESL: Print #1,"resumed at label"
On Error Goto TESTERR
Every 5 Gosub TICK
T=0 : Repeat : Wait 1 : Until T>=2
Every Off
Print #1,"ticks";T
Every 5 Proc PTICK
T=0 : Repeat : Wait 1 : Until T>=2
Every Off
Print #1,"proc ticks";T
Goto TESTEND
20 Print #1,"line 20" : Return
ZPOPR: Pop : Goto ZAFTP
ZAFTP: Print #1,"popped" : Goto ZBACK
RETRY: Inc CNT : If CNT<3 Then Resume
Resume Next
SKIP: Resume ZRESL
TICK: Inc T : Every On : Return
Procedure PA
  Print #1,"pa"
End Proc
Procedure PB
  Print #1,"pb"
End Proc
Procedure PC
  Print #1,"pc"
End Proc
Procedure EHANDLER
  Print #1,"handler";Errn
  Resume Next
End Proc
Procedure PTICK
  Shared T
  Inc T : Every On
End Proc
