Global GV
GV=10
Dim ARR(3)
ARR(2)=7
ZSHOWG
ZADDER[3,4] : Print #1,Param
ZNAMER["x",2.5] : Print #1,Param$
For X=1 To 2 : On X Proc ZP1,ZP2 : Next X
ZLEAVE[5] : Print #1,Param
ZLEAVE[2] : Print #1,Param
ZFACT[5] : Print #1,Param
I=0
Repeat
  Inc I
  While I<3
    Inc I
  Wend
Until I>4
Print #1,"I=";I
Goto TESTEND
Procedure ZSHOWG
  Shared ARR()
  Print #1,GV;ARR(2)
End Proc
Procedure ZADDER[A,B]
End Proc[A+B]
Procedure ZNAMER[S$,F#]
  Print #1,S$;F#
End Proc[S$+"!"]
Procedure ZP1
  Print #1,"p1"
End Proc
Procedure ZP2
  Print #1,"p2"
End Proc
Procedure ZLEAVE[N]
  If N>3 Then Pop Proc[N*10]
End Proc[0]
Procedure ZFACT[N]
  If N<=1
    R=1
  Else
    ZFACT[N-1]
    R=N*Param
  End If
End Proc[R]
