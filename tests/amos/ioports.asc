On Error Goto E
Print #1,"check" : Print #1,Serial Check(0)
Serial Open 0,0
Print #1,"base";Serial Base(0)<>0
Serial Speed 0,9600 : Serial Bits 0,8,1 : Serial Parity 0,-1 : Serial X 0,-1 : Serial Buf 0,1024
Serial Parity 0,1 : Serial Parity 0,3 : Serial X 0,$11130000
Serial Fast 0 : Serial Slow 0
B=Serial Base(0) : Print #1,"baud";Leek(B+60);Peek(B+76);Peek(B+77);Peek(B+78);Peek(B+79);Leek(B+56);Leek(B+52);Leek(B+48)
Print #1,"check";Serial Check(0);" error";Serial Error(0)
Print #1,"get";Serial Get(0)
A$=Serial Input$(0) : Print #1,"input";Len(A$)
Serial Send 0,"hello" : Print #1,"sent"
Serial Out 0,Start(1),0
Serial Out 0,Varptr(A$),-5
Serial Abort 0
Serial Close 0
Serial Open 1,0 : Print #1,"base1";Serial Base(1)<>0 : Serial Close 1
Serial Open 4,0
Serial Speed 9,1
Serial Open 0,0,1,1,1 : B=Serial Base(0) : Print #1,"flags";Peek(B+79) : Serial Close
Print #1,"x";Serial Base(2)
Printer Send "x"
Print #1,Printer Base
Print #1,Parallel Error
P$=Parallel Input$(5)
Printer Dump
Print #1,"end"
Goto FIN
E: Print #1,"error";Errn : Resume Next
FIN:
