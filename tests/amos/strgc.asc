Dim A$(40)
G$="global" : E$="" : S$="shared"
For R=1 To 30
  For I=0 To 40 : A$(I)=String$(Chr$(65+I mod 26),I+R)+Str$(I) : Next I
  T$=A$(R) : U$=T$
Next R
Print #1,A$(0);"|";Left$(A$(40),5);Len(A$(40));"|";T$=U$;Len(T$)
ZGC[5]
Print #1,Param$
B$="" : For I=1 To 500 : B$=B$+"ab" : If Len(B$)>300 Then B$=Mid$(B$,100)
Next I
Print #1,Len(B$);Left$(B$,6);G$;E$;"|";S$
C$=Space$(1000) : D$=Space$(1000) : C$="" : D$=Space$(2000) : Print #1,Len(D$)
For I=0 To 40 : A$(I)="" : Next I
F$=String$("z",5000) : Print #1,Len(F$);Right$(F$,3)
F$="" : D$="" : C$="" : B$=""
Dim W$(250)
For R=1 To 3 : For I=0 To 250 : W$(I)=Str$(I*R)+"#" : Next I : Next R
W$(5)=W$(7) : X$=W$(249)
For I=1 To 40 : Y$=String$("q",200) : Next I
Print #1,W$(0);W$(5);W$(150);W$(250);X$;Len(Y$)
Print #1,Free>0
Procedure ZGC[N]
  Shared S$
  For I=1 To 200 : L$=L$+Str$(I) : If Len(L$)>500 Then L$=Right$(L$,10)
  Next I
  S$=S$+"!"
End Proc[L$+"/"+Str$(N)]
