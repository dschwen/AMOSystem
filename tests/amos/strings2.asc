A$="abcdef"
Print #1,Left$(A$,2);"|";Left$(A$,0);"|";Left$(A$,9);"|";Right$(A$,2);"|";Right$(A$,0);"|";Right$(A$,9)
Print #1,Mid$(A$,3);"|";Mid$(A$,0);"|";Mid$(A$,7);"|";Mid$(A$,2,3);"|";Mid$(A$,5,9);"|";Mid$(A$,1,0);"|";Mid$("",1,2)
B$=A$ : Left$(B$,2)="XYZ" : Print #1,B$;" ";A$
B$=A$ : Mid$(B$,3)="12" : Print #1,B$
B$=A$ : Mid$(B$,5,9)="pqrs" : Print #1,B$
B$=A$ : Mid$(B$,0,2)="!!" : Print #1,B$
B$=A$ : Mid$(B$,9)="zz" : Print #1,B$
B$=A$ : Right$(B$,2)="RS" : Print #1,B$
B$="" : Left$(B$,2)="ab" : Print #1,"<";B$;">"
Print #1,Val("12");Val("-3.5");Val("$1F");Val("%11");Val("");Val("abc");Val("  7xyz");Val("1e3")
Print #1,Left$(A$,-1)
Print #1,Mid$(A$,-1)
Print #1,Len(Resource$(0))>0;Resource$(-1);"|";Resource$(-1001);"|";Resource$(-5001);"|";Resource$(-2001)
Print #1,Resource$(-6001)
