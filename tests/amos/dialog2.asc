Global N
Load "AMOSPRO:Tutorial/Tutorials/Interface/Example_Resource.Abk"
Resource Bank 16
Resource Screen Open 0,640,200,0
Flash Off : Curs Off : Cls 0 : Paper 0 : Pen 7
Palette ,,,,$222,$666,$AAA,$EEE
Dim V$(9) : For I=0 To 9 : V$(I)="Entry"+Str$(I) : Next I
T$="Go {[WORD,5,6]here} {[7,3,4]now}"+Chr$(10)+"Second line"+Chr$(0)
A$="SIze 400,150;BAse 16,8;BOx 0,0,1,SX,SY;"
A$=A$+"BUtton 1,16,10,64,14,0,0,2;[IN BP 2+,1,0;GB 0,0,SX,SY;PR 4,3,'B'BP#!,0;][]"
A$=A$+"BU 2,96,10,64,14,0,0,1;[IN 4,1,0;GB 0,0,SX,SY;PR 4,3,'Quit',0;][BQ;]"
A$=A$+"EDit 3,16,40,16,20,'',0,7;"
A$=A$+"DIgit 4,16,56,6,0,0,0,7;"
A$=A$+"BU 5,180,10,64,14,0,0,1;[IN 6,1,0;GB 0,0,SX,SY;PR 4,3,'Ok',0;][BQ;]KY 13,0;"
A$=A$+"HSlider 6,16,80,160,8,0,10,100,5;[]"
A$=A$+"AList 7,200,40,12,5,0VA,0,0,0,7;[]"
A$=A$+"HText 8,200,90,20,3,1VA,0,2,0,7;[]"
A$=A$+"EXit;"
Dialog Open 1,A$,8
Vdialog(1,0)=Array(V$(0)) : Vdialog(1,1)=Varptr(T$)
R=Dialog Run(1)
CLICK[50,25] : Print #1,Dialog(1);Rdialog(1,1)
CLICK[50,25] : Print #1,Dialog(1);Rdialog(1,1)
CLICK[40,52] : SIGNAL["type"] : PAUSE[150]
Print #1,Rdialog$(1,3);Rdialog(1,4)
Save Iff "AMOSTEST:out/dialog2_1.iff"
CLICK[180,92] : Print #1,Dialog(1);Rdialog(1,6)
CLICK[220,68] : Print #1,Dialog(1);Rdialog(1,7)
CLICK[236,102] : Print #1,Dialog(1);Rdialog$(1,8)
CLICK[276,102] : Print #1,Dialog(1);Rdialog(1,8)
Save Iff "AMOSTEST:out/dialog2_2.iff"
SIGNAL["enter"] : PAUSE[100] : Print #1,Dialog(1)
Save Iff "AMOSTEST:out/dialog2_3.iff"
Dialog Close
R=Dialog Box("SI 64,32;BA 0,0;BO 0,0,1,SX,SY;RU 25,0;EX;")
Print #1,R
SIGNAL["box"] : R=Dialog Box("SI 64,32;BA 0,0;BO 0,0,1,SX,SY;RU 0,4;EX;") : Print #1,R
Print #1,"end"
Procedure SIGNAL[F$]
   Open Out 9,"AMOSTEST:out/"+F$ : Close 9
End Proc
Procedure PAUSE[T]
   T0=Timer : While Timer-T0<T : Multi Wait : Wend
End Proc
Procedure CLICK[X,Y]
   X Mouse=128+X/2 : Y Mouse=50+Y
   Inc N : SIGNAL["c"+Str$(N)-" "] : PAUSE[60]
End Proc
