Def Fn TWICE(X)=X*2
Def Fn JOIN$(A$,B$)=A$+"-"+B$
Print #1,Fn TWICE(21);" ";Fn JOIN$("a","b")
For I=1 To 10
  Exit If I=4
Next I
Print #1,"exit if";I
I=0
Repeat
  Inc I
  Exit If I>2,1
Until I=10
Print #1,"repeat";I
Do
  For J=1 To 3
    If J=2 Then Exit 2
  Next J
Loop
Print #1,"exit 2";J
For K=1 To 3
  On K Gosub L1,L2,L3
Next K
On 2 Goto G1,G2
G1: Print #1,"g1"
G2: Print #1,"g2"
Print #1,""
X=3
If X=1
  Print #1,"one"
Else If X=3
  Print #1,"three"
Else
  Print #1,"other"
End If
A$="abcdef" : Mid$(A$,2,3)="XYZ" : Print #1,A$
Left$(A$,1)="Q" : Right$(A$,2)="RS" : Print #1,A$
Dim S(5) : S(0)=5 : S(1)=3 : S(2)=9 : S(3)=1 : S(4)=7 : S(5)=2
Sort S(0) : For I=0 To 5 : Print #1,S(I); : Next I : Print #1,""
Dim S$(3) : S$(0)="pear" : S$(1)="apple" : S$(2)="fig" : S$(3)="kiwi"
Sort S$(0) : Print #1,S$(0);" ";S$(3)
A=1 : B=2 : Swap A,B : Print #1,A;B
Add A,10 : Add B,5,0 To 20 : Dec A : Print #1,A;B
Error 23
Print #1,"after error"
Polyline 0,0 To 10,10 To 20,0
Polygon 30,0 To 40,10 To 50,0
Reserve As Work 10,64
Erase 10
Channel 1 To Sprite 0
Menu$(1)="Hello" : Menu$(1,1)="World" : Menu Del
Print #1,"menus"
LEAVER
Print #1,"popped"
Gosub SUB
Print #1,Param$
Goto TESTEND
SUB: Print #1,"sub" : Return
L1: Print #1,"l1"; : Return
L2: Print #1,"l2"; : Return
L3: Print #1,"l3"; : Return
Procedure LEAVER
  Print #1,"in leaver"
  Pop Proc
  Print #1,"never"
End Proc
