A=0 : Bset 3,A : Bset 31,A : Print #1,A : Bclr 3,A : Print #1,A : Bchg 0,A : Bchg 35,A : Print #1,A
Print #1,Btst(0,A);Btst(1,A);Btst(31,A);Btst(32,A)
Reserve As Work 10,16 : M=Start(10) : Fill M To M+16,0
Bset 1,M+0 : Bset 9,M+1 : Print #1,Peek(M);Peek(M+1) : Bchg 7,M+0 : Print #1,Peek(M);Btst(7,M+0);Btst(15,M+0)
Bclr 1,M+0 : Print #1,Peek(M) : Bset 1,M : Print #1,M-Start(10)
B=$12345678 : Ror.b 4,B : Print #1,Hex$(B) : Rol.b 12,B : Print #1,Hex$(B)
B=$12345678 : Ror.w 4,B : Print #1,Hex$(B) : Rol.w 20,B : Print #1,Hex$(B)
B=$12345678 : Ror.l 8,B : Print #1,Hex$(B) : Rol.l 40,B : Print #1,Hex$(B) : Rol.l 64,B : Print #1,Hex$(B)
Loke M,$80000001 : Ror.l 1,M+0 : Print #1,Hex$(Leek(M)) : Rol.w 4,M+0 : Print #1,Hex$(Deek(M)) : Ror.b 9,M+3 : Print #1,Hex$(Peek(M+3))
Dim T(2) : Bset 2,T(1) : Ror.b 1,T(1) : Print #1,T(1)
Erase 10
