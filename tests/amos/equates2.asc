Reserve As Work 10,64 : S=Start(10)
Struc(S,"LN_TYPE")=12 : Print #1,Peek(S+8);Struc(S,"LN_TYPE")
Struc(S,"LN_PRI")=-3 : Print #1,Peek(S+9);Struc(S,"LN_PRI")
Struc$(S,"LN_NAME")="hello" : Print #1,"[";Struc$(S,"LN_NAME");"]"
P=Leek(S+10) : Print #1,Peek(P);Peek(P+1);Peek(P+2);Peek(P+7)
Struc$(S,"LN_NAME")="|00|" : Print #1,Leek(S+10);"[";Struc$(S,"LN_NAME");"]"
Print #1,Lvo("Open");Equ("LN_SIZE")
Struc(S+1,"LN_SUCC")=1
Print #1,Struc(S+1,"LN_PRED")
Erase 10
