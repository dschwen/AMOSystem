Print #1,"[";Inkey$;"]";Scancode;Scanshift;Key Shift
Print #1,Key State(69);Joy(0);Joy(1);Jup(1);Jdown(1);Jleft(1);Jright(1);Fire(1);Fire(0)
Print #1,Joy(2)
Print #1,Key State(128)
Put Key "hi!"
A$=Inkey$ : B$=Inkey$ : C$=Inkey$ : D$=Inkey$
Print #1,A$;B$;C$;"[";D$;"]"
Put Key "xyz" : Clear Key : Print #1,"[";Inkey$;"]"
Put Key String$("q",64)
Key$(1)="Hello" : Key$(2)="List"+Chr$(13)+Chr$(10)+"Run'x"+Chr$(7) : Key$(20)=""
Print #1,Key$(1);"|";Key$(2);"|";Key$(20);"|";Len(Key$(3))
Print #1,Key$(0)
Print #1,Key$(21)
Key$(21)="no"
S$=Scan$(69) : T$=Scan$(80,3) : Print #1,Len(S$);Asc(S$);Asc(Mid$(S$,2));Asc(Mid$(S$,3));Asc(Mid$(S$,4));Asc(Mid$(T$,2));Asc(Mid$(T$,3))
Print #1,Scan$(256)
Print #1,Scan$(1,256)
Print #1,Free>1000
