Screen Open 0,320,200,8,Lowres : Curs Off : Flash Off : Cls 0
Mkdir "AMOSTEST:sub"
Open Out 2,"AMOSTEST:aaa.txt" : Close 2
Open Out 2,"AMOSTEST:bbb.txt" : Print #2,"12345" : Close 2
Open Out 2,"AMOSTEST:sub/inner.txt" : Close 2
Open Out 9,"AMOSTEST:out/a" : Close 9
F$=Fsel$("AMOSTEST:*.txt","","One") : Print #1,F$
Open Out 9,"AMOSTEST:out/b" : Close 9
F$=Fsel$("AMOSTEST:*.txt","","Two") : Print #1,F$
Open Out 9,"AMOSTEST:out/c" : Close 9
F$=Fsel$("AMOSTEST:sub/","","Three") : Print #1,F$
Open Out 9,"AMOSTEST:out/d" : Close 9
F$=Fsel$("AMOSTEST:nothere/","","Four") : Print #1,F$
Print #1,"end"
