Dim A(9),S$(5),F#(4)
For I=0 To 9 : Read A(I) : Next I
Sort A(0) : For I=0 To 9 : Print #1,A(I); : Next I : Print #1,""
Print #1,Match(A(0),7);Match(A(0),8);Match(A(0),-50);Match(A(0),100);Match(A(0),2.9)
For I=0 To 5 : Read S$(I) : Next I
Sort S$(0) : For I=0 To 5 : Print #1,"[";S$(I);"]"; : Next I : Print #1,""
Print #1,Match(S$(0),"pear");Match(S$(0),"b")
For I=0 To 4 : Read F#(I) : Next I
Sort F#(0) : For I=0 To 4 : Print #1,F#(I); : Next I : Print #1,""
Print #1,Match(F#(0),1.5);Match(F#(0),2)
Read X,Y$,Z# : Print #1,X;Y$;Z#
Read P,Q$ : Print #1,P;"<";Q$;">"
Read R : Print #1,R
Read R
Print #1,"end"
Data 5,3,9,-1,7,3,0,12,7,2
LBL: Data "pear","apple","","fig","apple","b"
Data 2.5,-1,1.5,1E3,0
Data 3.7,"s",4
Data ,
Data 10
