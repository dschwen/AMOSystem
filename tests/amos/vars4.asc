Set Double Precision
A=1 : B=2 : Swap A,B : Print #1,A;B
A$="x" : B$="yy" : Swap A$,B$ : Print #1,A$;B$
F#=1.5 : G#=2.5 : Swap F#,G# : Print #1,F#;G#
Dim T(3) : T(1)=5 : T(2)=9 : Swap T(1),T(2) : Print #1,T(1);T(2)
Def Fn SQ(X)=X*X
Def Fn HYP#(X#,Y#)=Sqr(X#*X#+Y#*Y#)
Def Fn CAT$(S$,N)=S$+Str$(N)
Def Fn K=42
Print #1,Fn SQ(7);Fn HYP#(3,4);Fn CAT$("n",5);Fn K;Fn SQ(2.9)
X=100 : Print #1,Fn SQ(3);X
Print #1,Not 0;Not -1;Not 5;Not 2.5
Print #1,Array(T(0))-Varptr(T(0))
V=5 : Add V,10,0 To 12 : Print #1,V : Add V,-20,0 To 12 : Print #1,V : Add V,3,0 To 12 : Print #1,V
Print #1,$7FFFFFFF;%101;1.25;"str";'single'
Print #1,1E10;1.0E-5;-0.5
