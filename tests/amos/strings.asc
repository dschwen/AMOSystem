A$="Hello AMOS World"
Print #1,Len(A$)
Print #1,Left$(A$,5);"|";Right$(A$,5);"|";Mid$(A$,7,4);"|";Mid$(A$,7)
Print #1,Upper$(A$);"|";Lower$(A$);"|";Flip$(A$)
Print #1,Instr(A$,"AMOS");Instr(A$,"o",6);Instr(A$,"xyz")
Print #1,String$("ab",4);"|";Space$(3);"|";Chr$(65);Asc("Z")
Print #1,Str$(123);"|";Str$(-45);"|";Val("678");Val("-12");Val("$FF");Val("%101")
Print #1,Hex$(255);"|";Hex$(255,4);"|";Bin$(5);"|";Bin$(5,8)
B$=A$ : Mid$(B$,1,5)="HOWDY" : Print #1,B$
Left$(B$,2)="XY" : Right$(B$,2)="ZZ" : Print #1,B$
C$="" : For I=1 To 20 : C$=C$+Chr$(64+I) : Next I : Print #1,C$
Print #1,"abc"<"abd";"b">"a";"x"="x";"a"<>"a"
Print #1,"[";Upper$("");"][";Lower$("");"][";Upper$("a1z{`@");"][";Lower$("A1Z[@");"]"
Print #1,"[";Space$(0);"][";Space$(1);"][";Space$(4);"][";String$("",3);"][";String$("xy",0);"][";String$("q",1);"]"
Print #1,Len(Space$(1001));Len(String$("z",999));Len(Upper$(Space$(77)))
E$=Upper$(Chr$(228)+"bc"+Chr$(255)) : Print #1,Asc(E$);Asc(Mid$(E$,2));Asc(Right$(E$,1))
Print #1,Space$(-1)
Print #1,String$("a",-5)
D$="" : For I=1 To 300 : D$=Upper$(Lower$(Space$(I)+"Ab")) : Next I : Print #1,Len(D$);Right$(D$,2)
K=0 : For I=1 To 3000 : G$=Upper$(Lower$(String$("k",I mod 900)+Space$(I mod 333)+"x")) : K=K+Len(G$) : Next I : Print #1,K;Free>0
