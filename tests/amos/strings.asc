A$="Hello AMOS World"
Print #1,Len(A$)
Print #1,Left$(A$,5);"|";Right$(A$,5);"|";Mid$(A$,7,4);"|";Mid$(A$,7)
Print #1,Upper$(A$);"|";Lower$(A$);"|";Flip$(A$)
Print #1,Instr(A$,"AMOS");Instr(A$,"o",6);Instr(A$,"xyz")
Print #1,String$("ab",4);"|";Space$(3);"|";Chr$(65);Asc("Z")
Print #1,Str$(123);"|";Str$(-45);"|";Val("678");Val("-12");Val("$FF");Val("%101")
Print #1,Hex$(255);"|";Hex$(255,4);"|";Bin$(5);"|";Bin$(5,8)
B$=A$ : Mid$(B$,1,5)="HOWDY" : Print #1,B$
Left$(B$,2)="XY" : Right$(B$,2)="ZZ" : Print #1,B$
C$="" : For I=1 To 20 : C$=C$+Chr$(64+I) : Next I : Print #1,C$
Print #1,"abc"<"abd";"b">"a";"x"="x";"a"<>"a"
Print #1,"[";Upper$("");"][";Lower$("");"][";Upper$("a1z{`@");"][";Lower$("A1Z[@");"]"
Print #1,"[";Space$(0);"][";Space$(1);"][";Space$(4);"][";String$("",3);"][";String$("xy",0);"][";String$("q",1);"]"
Print #1,Len(Space$(1001));Len(String$("z",999));Len(Upper$(Space$(77)))
E$=Upper$(Chr$(228)+"bc"+Chr$(255)) : Print #1,Asc(E$);Asc(Mid$(E$,2));Asc(Right$(E$,1))
Print #1,Space$(-1)
Print #1,String$("a",-5)
D$="" : For I=1 To 300 : D$=Upper$(Lower$(Space$(I)+"Ab")) : Next I : Print #1,Len(D$);Right$(D$,2)
K=0 : For I=1 To 3000 : G$=Upper$(Lower$(String$("k",I mod 900)+Space$(I mod 333)+"x")) : K=K+Len(G$) : Next I : Print #1,K;Free>0
Print #1,Len("");Len("abc");Asc("");Asc("A");Asc(Chr$(200));Len(Chr$(0))
Print #1,Chr$(256)
Print #1,Chr$(-1)
Print #1,Asc(Tab$);Asc(Cleft$);Asc(Cright$);Asc(Cup$);Asc(Cdown$)
P$=Pen$(3)+Paper$(31) : Print #1,Len(P$);:For I=1 To Len(P$):Print #1,Asc(Mid$(P$,I));:Next I:Print #1,""
Print #1,Pen$(32)
P$=At(3,4)+At(,9)+At(7,)+At(,) : Print #1,Len(P$);:For I=1 To Len(P$):Print #1,Asc(Mid$(P$,I));:Next I:Print #1,""
Print #1,At(208,1)
P$=Cmove$(3,-4)+Cmove$(0,5)+Cmove$(-127,0)+Cmove$(0,0) : Print #1,Len(P$);:For I=1 To Len(P$):Print #1,Asc(Mid$(P$,I));:Next I:Print #1,""
Print #1,Cmove$(128,0)
P$=Repeat$("ab",5)+Border$("",3)+Zone$("z",206) : Print #1,Len(P$);:For I=1 To Len(P$):Print #1,Asc(Mid$(P$,I));:Next I:Print #1,""
Print #1,Repeat$("x",0)
Print #1,Border$("x",16)
Print #1,Hex$(0);"|";Hex$(-1);"|";Hex$($1234,2);"|";Hex$($1234,0);"|";Hex$($1234,9);"|";Hex$($A,8)
Print #1,Bin$(0);"|";Bin$(-1);"|";Bin$(%1011,2);"|";Bin$(6,0);"|";Bin$(6,40)
Print #1,Instr("abcabc","c");Instr("abcabc","c",4);Instr("abcabc","");Instr("","a");Instr("abcabc","bca");Instr("aab","ab");Instr("abc","abcd");Instr("abcabc","abc",0);Instr("abcabc","abc",2)
Print #1,Instr("abc","a",-1)
Print #1,Flip$("");"|";Flip$("x");"|";Flip$("abcdef")
Print #1,"Hello"-"l";"|";"abcabc"-"bc"
