For I=-14 To 14
  X#=1.23456789 : For J=1 To Abs(I) : If I<0 Then X#=X#/7 Else X#=X#*7
  Next J
  Print #1,X#;" ";Str$(-X#)
Next I
For F=-1 To 9
  Fix F : Print #1,F;" ";3.14159265;" ";-0.000123456;" ";123456.789;" ";1E20;" ";0.5;" ";100.0
Next F
For F=16 To 23
  Fix F : Print #1,F;" ";3.14159265;" ";-0.000123456;" ";123456.789;" ";1E20;" ";0.5
Next F
For F=-1 To -16 Step -1
  Fix F : Print #1,F;" ";3.14159265;" ";-0.000123456;" ";123456.789;" ";1E20;" ";0.5;" ";1E-15
Next F
Fix -3
For I=1 To 60 : X#=I/3.0+I*I*0.37 : Print #1,X#;" "; : Next I : Print #1,""
For I=1 To 30 : X#=1.0/I : Print #1,X#;" "; : Next I : Print #1,""
Fix 16
Print #1,0.0;-0.0;1E-30;9.99999E37;0.1;0.01;0.001;0.0001;0.00001
Print #1,Val("1.5e3");Val("  -2.25");Val("1e-5");Val("123456789");Val("0.000001234");Val("1.5e005");Val("1234567890123456789")
Print #1,Val("3.");Val(".5");Val("-.75e+2");Val("7e-012");Val("1.25E10");Val("0.1e1");Val("-0");Val("2.5e-30")
X#=1.0 : For I=1 To 19 : X#=X#*10 : Print #1,X#;" ";X#+0.5;" ";-X#/3 : Next I
X#=1.0 : For I=1 To 40 : X#=X#/3 : Print #1,X#;" "; : Next I : Print #1,""
For I=1 To 40 : X#=I*0.1-2 : Print #1,X#;" "; : Next I : Print #1,""
