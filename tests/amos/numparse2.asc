Set Double Precision
Print #1,Val("1 2");Val("$fFz");Val("%1012");Val("1e3");Val(" -.5");Val("1.2.3");Val("  +7");Val("1E+2")
Print #1,Val("99999999999");Val("2147483647");Val("2147483648");Val("$123456789");Val("$7FFFFFFF");Val("$FFFFFFFF")
Print #1,Val("%11111111111111111111111111111111");Val("%111111111111111111111111111111111");Val("-$10");Val("- 5")
Print #1,Val("12abc");Val(".");Val("-");Val("1e");Val("1.5e-2");Val("3E 2");Val("0.25");Val("$");Val("%")
A$="1.5E3" : Print #1,Val(A$);A$
