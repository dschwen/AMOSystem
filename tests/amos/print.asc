Print #1,1,2;3;"a";"b",-4
Print #1,Using "###.##";3.14159
Print #1,Using "+###";42;" ";Using "-###";42;" ";Using "-###";-42
Print #1,Using "##.##^^^^";1234.5
Print #1,Using "~~~~";"abcdefg";"|";Using "x~y~z";"12"
Print #1,Using "###";12345;"|";Using "#;##";3.5
A$=String$("x",130)+"END" : Print #1,A$
Print #1,"no newline";
Print #1," after"
F$="RAM:amosprint.txt"
Open Out 2,F$ : Print #2,"a,b,c" : Print #2,"12,3.5" : Print #2,"x" : Print #2,"7" : Close 2
Open In 2,F$
Input #2,A$,B$,C$ : Print #1,A$;"|";B$;"|";C$
Input #2,N,F# : Print #1,N;F#
Input #2,P$,Q : Print #1,P$;Q
Close 2
Open In 2,F$ : Line Input #2,L$ : Print #1,L$ : Close 2
Kill F$
