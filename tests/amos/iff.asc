Load Iff "AMOSPRO:Examples/Iff/Logo.iff",0 : Print #1,Screen Width;Screen Height;Screen Colour
Save Iff "AMOSTEST:out/iff_1.iff"
Load Iff "AMOSPRO:Productivity2/Wonderland/Landscape.Iff",1 : Print #1,Screen Width;Screen Height;Screen Colour
Save Iff "AMOSTEST:out/iff_2.iff",0
Load Iff "AMOSPRO:Productivity2/Procedures/Screen_FX/Sine_Pic.iff",2 : Save Iff "AMOSTEST:out/iff_3.iff",2
Screen Open 3,320,200,16,Lowres : Cls 0 : Palette $FFF,$F00
Mask Iff Picture-4 : Load Iff "AMOSPRO:Productivity2/Wonderland/Title_Screen.Iff" : Mask Iff Picture
Print #1,Hex$(Colour(0));Hex$(Colour(1)) : Save Iff "AMOSTEST:out/iff_4.iff"
Load Iff "AMOSPRO:nothere.iff"
Load Iff "AMOSTEST:out/iff.txt"
Load Iff "AMOSPRO:Examples/Iff/Logo.iff",8
Save Iff "AMOSTEST:out/x.iff",3
Open In 2,"AMOSPRO:Accessories/System_Iffs/AMOSPro.Iff"
L=Frame Length(2) : Print #1,L
Reserve As Work 10,L : A=Frame Load(2 To Start(10)) : Print #1,A;Leek(Start(10))=$464F524D
Close 2 : Open In 2,"AMOSPRO:Accessories/System_Iffs/AMOSPro.Iff"
A=Frame Load(2 To 11,1) : Print #1,A;Length(11)
Close 2
Screen Open 4,320,256,32,Lowres : Cls 0
B=Frame Play(11,1,5) : Print #1,B-Start(11);Screen Width;Screen Height
B=Frame Skip(11) : Print #1,B-Start(11);Frame Param
Save Iff "AMOSTEST:out/iff_5.iff"
Print #1,Frame Length(9)
Command Line$="hello world" : Print #1,Command Line$;"|";Len(Command Line$)
Command Line$="" : Print #1,"[";Command Line$;"]"
Open In 2,"AMOSPRO:Tutorial/Iff_Anim/AMOS.Anim" : N=Frame Load(2 To 12,200) : Close 2 : Print #1,N;Length(12)
Mask Iff 255 : A=Frame Play(12,1,6) : For I=1 To 40 : A=Frame Play(A,1) : Next I : Print #1,A-Start(12);Frame Param
Save Iff "AMOSTEST:out/iff_6.iff"
For I=1 To 30 : A=Frame Play(A,1) : Next I : Save Iff "AMOSTEST:out/iff_7.iff"
Print #1,"end"
