Screen Open 0,320,200,16,Lowres : Curs Off : Flash Off : Cls 0
Set Rainbow 0,1,40,"(2,1,15)","(1,-1,3)(3,$2,4)","(1,3,2)",$123
A$="" : For I=0 To 39 : A$=A$+Hex$(Rain(0,I))+" " : Next I : Print #1,A$
Set Rainbow 1,2,24,"","(1,1,15)",""
A$="" : For I=0 To 23 : A$=A$+Hex$(Rain(1,I))+" " : Next I : Print #1,A$
Set Rainbow 2,3,20,"( 1 , 2 , 3 )Zrest","(1,1,2)  (2,-2,1)","(1,15,1)",$FFF
A$="" : For I=0 To 19 : A$=A$+Hex$(Rain(2,I))+" " : Next I : Print #1,A$
Set Rainbow 3,4,16,"(1,1,1)ignored|","(1,$a,1)","(1,-$3,2)",$8
A$="" : For I=0 To 15 : A$=A$+Hex$(Rain(3,I))+" " : Next I : Print #1,A$
Rain(0,5)=$ABC : Print #1,Hex$(Rain(0,5))
Rainbow 0,10,50,100 : Rainbow 1,,60, : Rainbow Del 2
Trap Print #1,Rain(2,0) : Print #1,Errtrap
Trap Print #1,Rain(0,40) : Print #1,Errtrap
Trap Set Rainbow 1,16,20,"(1,1,1)","","" : Print #1,Errtrap
Trap Set Rainbow 1,1,20,"(0,1,1)","","" : Print #1,Errtrap
Trap Set Rainbow 1,1,20,"(1,1,-1)","","" : Print #1,Errtrap
Trap Set Rainbow 1,1,20,"1,1,1)","","" : Print #1,Errtrap
Trap Set Rainbow 1,1,20,"(1,1,1","","" : Print #1,Errtrap
Trap Print #1,Rain(1,0) : Print #1,Errtrap
Trap Rainbow 1,0,0,10 : Print #1,Errtrap
Rainbow Del : Trap Print #1,Rain(0,0) : Print #1,Errtrap
Set Rainbow 0,1,16,"(1,1,1)","","" : Rainbow 0,0,40,30 : Wait Vbl : Rainbow Del
Print #1,"end"
