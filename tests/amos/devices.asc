Lib Open 1,"dos.library",0 : Print #1,Lib Base(1)<>0;Lib Base(2)
Lib Open 1,"dos.library",0
Lib Open 2,"nothere.library",0
Lib Open 8,"dos.library",0
Lib Open 3,"",0
Dreg(1)=0 : Print #1,Lib Call(1,-132)>=0
Print #1,Execall(-132)<>0
Lib Close 1 : Print #1,Lib Base(1)
Lib Open 4,"graphics.library",33 : Lib Close
Print #1,Lib Base(4)
Dev Open 1,"timer.device",40,1,0 : Print #1,Dev Base(1)<>0;Dev Check(1)
Dev Do 1,9
Print #1,Dev Check(1)<>0
Dev Open 1,"timer.device",40,0,0
Dev Open 2,"nothere.device",40,0,0
Dev Open 2,"timer.device",0,0,0
Dev Close 1 : Print #1,Dev Base(1)
Dev Do 1,9
Dev Open 3,"timer.device",40,1,0 : Dev Close
Print #1,Dev Base(3)
Exec "Workbench:C/Wait 0"
Exec ""
Serial Open 0,0 : Print #1,Serial Base(0)<>0;Serial Check(0)
Serial Speed 0,9600 : Serial Bits 0,8,1 : Serial Parity 0,-1 : Serial X 0,0
Serial Send 0,"hello" : Print #1,Serial Check(0)<>0
Serial Open 0,0
Serial Close 0 : Print #1,Serial Base(0)
Serial Send 0,"x"
Print #1,"end2"
