Dim A(3),B#(2,3),C$(4),D(2,2,2)
For I=0 To 3 : A(I)=I*I : Next I
Print #1,A(0);A(1);A(2);A(3)
For I=0 To 2 : For J=0 To 3 : B#(I,J)=I+J/4 : Next J : Next I
Print #1,B#(0,0);B#(1,2);B#(2,3)
C$(2)="two" : C$(4)=C$(2)+"!" : Print #1,C$(2);C$(4);Len(C$(0));"<"+C$(1)+">"
D(1,2,0)=5 : D(2,2,2)=D(1,2,0)*3 : Print #1,D(1,2,0);D(2,2,2);D(0,0,0)
X=7.9 : Print #1,X : Y#=3 : Print #1,Y# : Z$="s" : Print #1,Z$
A(1)=2.6 : Print #1,A(1) : B#(1,1)=7 : Print #1,B#(1,1)
Inc A(2) : Dec A(3) : Add A(0),5 : Print #1,A(0);A(2);A(3)
Print #1,A(4)
Print #1,D(3,0,0)
E=1 : Print #1,A(E+1)*2;A(A(1))
Print #1,Varptr(A(1))-Varptr(A(0))
S$="" : Print #1,Len(S$);S$="";T$=""
Global G,G$
G=10 : G$="glob"
ZP
Print #1,G;G$;L
Procedure ZP
  L=3 : G=G+L : G$=G$+"al"
  Print #1,G;G$;L
End Proc
