Screen Open 0,320,200,8,Lowres : Curs Off : Flash Off : Cls 0
Menu$(1)=" Project " : Menu$(1,1)=" Open    " : Menu$(1,2)=" Save    " : Menu$(1,3)=" Quit    "
Menu$(2)=" Edit " : Menu$(2,1)=" Cut  " : Menu$(2,2)=" Copy " : Menu$(2,2,1)=" Sub " : Menu$(2,2,2)=" Two "
Menu Inactive(1,2)
Menu On
Print #1,X Menu(1);Y Menu(1);X Menu(1,1);Y Menu(1,2);Choice
X Mouse=158 : Y Mouse=54
Open Out 9,"AMOSTEST:out/ready" : Close 9
T=Timer : While Choice=0 and Timer-T<500 : Multi Wait : Wend
Print #1,Choice(1);Choice(2);Choice(3)
X Mouse=158 : Y Mouse=54 : Open Out 9,"AMOSTEST:out/again" : Close 9
T=Timer : While Choice=0 and Timer-T<500 : Multi Wait : Wend
Print #1,Choice(1);Choice(2);Choice(3)
Menu Off : Menu Del
Print #1,"end"
