Mkdir "RAM:d" : Mkdir "RAM:d/sub"
For I=1 To 5 : Open Out 3,"RAM:d/file"+Str$(I)-" "+".txt" : Print #3,String$("x",I*10) : Close 3 : Next I
Open Out 3,"RAM:d/Other.abk" : Close 3 : Open Out 3,"RAM:d/info.info" : Close 3
A$=Dir First$("RAM:d/") : While A$<>"" : Print #1,"[";A$;"]" : A$=Dir Next$ : Wend
A$=Dir First$("RAM:d/*.txt") : While A$<>"" : Print #1,"[";A$;"]" : A$=Dir Next$ : Wend
A$=Dir First$("RAM:d/f?le3.*/*.abk") : While A$<>"" : Print #1,"[";A$;"]" : A$=Dir Next$ : Wend
Set Dir 20,"*.info" : A$=Dir First$("RAM:d/") : While A$<>"" : Print #1,"[";A$;"]" : A$=Dir Next$ : Wend
Set Dir 30,"" : Print #1,Dir Next$
Set Dir 0
Set Dir 200
Print #1,Dir First$("RAM:d/*/sub")
A$=Dev First$("RAM*") : While A$<>"" : Print #1,"[";A$;"]" : A$=Dev Next$ : Wend
Screen Open 0,640,200,4,Hires : Curs Off : Paper 0 : Pen 1 : Cls 0
Dir "RAM:d/"
Dir/w "RAM:d/*.txt"
Dir$="RAM:d" : Dir
Save Iff "AMOSTEST:out/dirs_1.iff"
Print #1,"end"
