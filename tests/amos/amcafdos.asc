Rem AMCAF WLOAD, DLOAD, WSAVE, DSAVE, IO ERROR (the golden is the original's)
Reserve As Work 5,333
For I=0 To 330 Step 2 : Doke Start(5)+I,I*7+1 : Next I
Wsave "AMOSTEST:out/w1.bin",5
Dsave "AMOSTEST:out/w2.bin",5
Wload "AMOSTEST:out/w1.bin",6
Dload "AMOSTEST:out/w2.bin",7
Print #1,"len";Length(5);Length(6);Length(7)
For B=6 To 7
C=0
For I=0 To 330 Step 2 : C=C+Deek(Start(B)+I)*(I+1) : Next I
Print #1,"sum";B;C
Next B
Wload "AMOSTEST:out/w1.bin",5
Print #1,"replaced";Length(5)
Print #1,"flags";Leek(Start(6)-12);Leek(Start(7)-12);Peek$(Start(6)-8,8);Peek$(Start(7)-8,8)
Erase 6 : Erase 7
Trap Wload "AMOSTEST:out/nothere.bin",8
Print #1,"nofile";Errtrap;Io Error
Trap Wsave "AMOSTEST:out/nothere/x.bin",5
Print #1,"badsave";Errtrap;Io Error
Trap Wsave "",5
Print #1,"empty";Errtrap
Trap Wload "AMOSTEST:out/w1.bin",70000
Print #1,"bignum";Errtrap;Length(70000-65536)
Trap Wsave "AMOSTEST:out/w3.bin",44
Print #1,"nobank";Errtrap
Trap Wsave "AMOSTEST:out/w3.bin",1
Print #1,"bobs";Errtrap
Open In 2,"AMOSTEST:out/w1.bin"
Print #1,"len";Lof(2)
Close 2
