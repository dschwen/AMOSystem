F$="RAM:amostest.txt"
Open Out 2,F$ : Print #2,"line one" : Print #2,42 : Close 2
Open In 2,F$ : Line Input #2,A$ : Input #2,N : Close 2
Print #1,A$;"|";N
Append 2,F$ : Print #2,"line three" : Close 2
Open In 2,F$ : C=0 : While Not Eof(2) : Line Input #2,L$ : Inc C : Wend : Close 2
Print #1,C
Print #1,Exist(F$);Exist("RAM:nothere")
Open In 2,F$ : Print #1,Lof(2) : Close 2
Rename F$ To "RAM:amostest2.txt" : Print #1,Exist("RAM:amostest2.txt")
Kill "RAM:amostest2.txt" : Print #1,Exist("RAM:amostest2.txt")
Open Out 3,"RAM:t1.txt" : Print #3,"abcdef" : Print #3,"12,34" : Close 3
Open In 3,"RAM:t1.txt" : Print #1,Lof(3);Pof(3);Eof(3) : A$=Input$(3,4) : Print #1,A$;Pof(3)
Pof(3)=1 : Print #1,Input$(3,2) : Input #3,X$ : Print #1,X$;Eof(3) : Input #3,P,Q : Print #1,P;Q;Eof(3)
Print #1,Input$(3,5)
Close 3
Open In 3,"RAM:t1.txt" : Open In 3,"RAM:t1.txt"
Close 3 : Close 3
Print #1,Lof(4)
Open In 11,"RAM:t1.txt"
Open In 0,"RAM:t1.txt"
Open In 4,"RAM:nothere.txt"
Open Out 4,"RAM:t2.txt" : Print #1,Input$(4,1) : Close 4
Open Random 5,"RAM:r.dat" : Field 5,4 As N$,6 As M$
N$="ab" : M$="012345678" : Put 5,1 : N$="WXYZ" : M$="x" : Put 5,3 : Print #1,Lof(5)
N$="" : M$="" : Get 5,1 : Print #1,N$;"|";M$;"|" : Get 5,3 : Print #1,N$;"|";M$;"|"
Get 5,4
Get 5,0
Close 5
Append 6,"RAM:t1.txt" : Print #6,"more" : Close 6
Open In 6,"RAM:t1.txt" : Print #1,Lof(6) : Close 6
Set Input 44,-1 : Open In 6,"RAM:t1.txt" : Input #6,A$,B$ : Print #1,A$;"/";B$ : Close 6 : Set Input 10,-1
Set Input 256,0
Mkdir "RAM:tdir" : Print #1,Exist("RAM:tdir");Exist("");Exist("RAM:tdir/x")
Dir$="RAM:tdir" : Print #1,Dir$ : Open Out 7,"inner" : Print #7,"x" : Close 7 : Print #1,Exist("RAM:tdir/inner")
Parent : Print #1,Dir$
Dir$="RAM:t1.txt"
Print #1,Dir$
Kill "RAM:tdir/inner" : Kill "RAM:tdir" : Print #1,Exist("RAM:tdir")
Kill "RAM:tdir"
Rename "RAM:nothere" To "RAM:x"
Print #1,Drive("RAM:");Drive("RAM");Drive("NOTHERE:");Drive("")
Print #1,Dfree>0;Len(Disc Info$("RAM:"))>10;Left$(Disc Info$("RAM:"),4)
Reserve As Work 20,64 : Fill Start(20) To Start(20)+64,$41424344
Bsave "RAM:b.bin",Start(20) To Start(20)+10 : Erase 20 : Reserve As Work 21,64
Bload "RAM:b.bin",21 : Print #1,Peek$(Start(21),12)
Bload "RAM:b.bin",Start(21)+20 : Print #1,Peek$(Start(21)+18,12)
Bsave "RAM:b.bin",Start(21) To Start(21)
Pload "Workbench:C/Echo",22 : Print #1,Length(22)>0;Leek(Start(22))<>0
Pload "Workbench:C/Echo",0
Pload "RAM:b.bin",23
Print #1,"end"
