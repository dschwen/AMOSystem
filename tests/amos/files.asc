F$="RAM:amostest.txt"
Open Out 2,F$ : Print #2,"line one" : Print #2,42 : Close 2
Open In 2,F$ : Line Input #2,A$ : Input #2,N : Close 2
Print #1,A$;"|";N
Append 2,F$ : Print #2,"line three" : Close 2
Open In 2,F$ : C=0 : While Not Eof(2) : Line Input #2,L$ : Inc C : Wend : Close 2
Print #1,C
Print #1,Exist(F$);Exist("RAM:nothere")
Open In 2,F$ : Print #1,Lof(2) : Close 2
Rename F$ To "RAM:amostest2.txt" : Print #1,Exist("RAM:amostest2.txt")
Kill "RAM:amostest2.txt" : Print #1,Exist("RAM:amostest2.txt")
