Screen Open 0,320,200,8,Lowres : Curs Off : Flash Off : Cls 0
Menu$(1)=" A "," B "," C " : Menu$(1,1)=" one "," ONE " : Menu$(1,2)=" two " : Menu$(2)=" X "
Menu Key(1,1) To "o" : Menu Key(1,2) To 80,8 : Menu Key(1,2)
Menu Key(1,1) To ""
Menu Key(1,1) To 200
Set Menu(1,2) To 10,20
Print #1,X Menu(1,2);Y Menu(1,2)
Menu Del(1,1)
Print #1,X Menu(1,1)
Menu Del(9)
Menu$(1,2)=,," zz "
Menu$(1,2)=""
Menu Del
Print #1,"end"
