For I=1 To 5 : Print #1,I; : Next I : Print #1,""
For I=10 To 0 Step -3 : Print #1,I; : Next I : Print #1,""
I=0 : While I<4 : Inc I : Print #1,I; : Wend : Print #1,""
I=0 : Repeat : Inc I : Print #1,I; : Until I=3 : Print #1,""
I=0 : Do : Inc I : If I=4 Then Exit : Print #1,I; : Loop : Print #1,""
For I=1 To 3 : If I=2 Then Print #1,"two" Else Print #1,"not two"
Next I
If I>2
  Print #1,"block if"
Else
  Print #1,"block else"
End If
On 2 Gosub G1,G2,G3
Gosub G3
Dim T(10),N$(3)
For I=0 To 10 : T(I)=I*I : Next I : Print #1,T(3);T(10)
N$(1)="one" : N$(2)="two" : Print #1,N$(1);N$(2)
Dim M(2,3) : M(1,2)=12 : M(2,3)=23 : Print #1,M(1,2)+M(2,3)
Restore DAT : For I=1 To 4 : Read V : Print #1,V; : Next I : Print #1,""
Read S$ : Print #1,S$
SQUARE[7] : Print #1,Param
TELL["proc"]
FACT[6] : Print #1,Param
GG=5 : BUMP : Print #1,GG
Goto TESTEND
G1: Print #1,"g1" : Return
G2: Print #1,"g2" : Return
G3: Print #1,"g3" : Return
DAT: Data 1,2,3,4,"text"
Procedure SQUARE[N]
End Proc[N*N]
Procedure TELL[S$]
  Print #1,"say ";S$
End Proc
Procedure FACT[N]
  If N<=1 Then R=1 Else FACT[N-1] : R=N*Param
End Proc[R]
Procedure BUMP
  Shared GG
  GG=GG+1
End Proc
