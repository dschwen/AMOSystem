F$="RAM:amosfields.dat"
Open Random 2,F$
Field 2,6 As N$,4 As A$,10 As C$
N$="Alice" : A$="30" : C$="Paris" : Put 2,1
N$="Bob" : A$="41" : C$="Rome and more text" : Put 2,2
N$="" : A$="" : C$="" : Get 2,1 : Print #1,"[";N$;"][";A$;"][";C$;"]"
Get 2,2 : Print #1,"[";N$;"][";A$;"][";C$;"]"
Print #1,Lof(2)
Close 2
Open Random 3,F$
Field 3,0 As Z$
Kill F$
