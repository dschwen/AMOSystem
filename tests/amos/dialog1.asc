Load "AMOSPRO:Tutorial/Tutorials/Interface/Example_Resource.Abk"
Resource Bank 16
Resource Screen Open 0,640,200,0
Flash Off : Curs Off : Cls 0 : Paper 0 : Pen 7
Palette ,,,,$222,$666,$AAA,$EEE
Dim V$(5) : For I=0 To 5 : V$(I)="Item"+Str$(I) : Next I
T$="Plain line"+Chr$(10)+"A {[1,3,4]link} here"+Chr$(10)+"Third {[two,5,6]x}"+Chr$(10)+"4"+Chr$(10)+"5"
A$="SIze 400,150;BAse 16,8;"
A$=A$+"BOx 0,0,1,SX,SY;"
A$=A$+"PRint 16,10,'Hello',8;PO 16,20,'Outlined',0,13;VText 380,10,'VERT',6;"
A$=A$+"INk 3,2,0;GB 100,10,140,20;INk 4,0,0;GSquare 150,10,190,30;GLine 200,10,240,30;"
A$=A$+"SLine %1111000011110000;GL 200,30,240,10;SLine $FFFF;"
A$=A$+"GEllipse 270,20,15,8;GPlot 300,20,5;SPattern 11,1;INk 1,0,2;GB 310,10,340,25;SPattern 0,0;"
A$=A$+"LIne 16,40,10,200;VLine 360,40,19,110;UNpack 220,40,22;"
A$=A$+"SVar 0,1 2+;SV 1,10 3-;SV 2,6 7*;SV 3,100 7/;SV 4,5NE;SV 5,3 5MI;SV 6,3 5MA;"
A$=A$+"SV 8,1 2=;SV 9,2 2=;SV 10,1 2\;SV 11,1 2<;SV 12,1 2>;SV 13,6 3&;"
A$=A$+"SV 15,'Hi' 'There'!;SV 16,12345#;SV 17,15VA TL;SV 18,'Hello'TW;SV 19,TH;SV 20,'Hello'CX;"
A$=A$+"SV 21,SW;SV 22,SH;SV 23,SX SY+;SV 24,BX BY+;XY 1,2,3,4;SV 25,XA YA+XB+YB+;"
A$=A$+"SZ 77;SV 26,ZV;SV 27,7VA 2AR;SV 28,7VA AS;"
A$=A$+"ZZ 6,7;"
A$=A$+"IF 1 2<;[SV 30,99;]IF 0;[SV 31,98;]"
A$=A$+"JS 50;SV 33,2;JP 60;LA 50;SV 32,1;RT;LA 60;"
A$=A$+"BUtton 1,16,60,64,14,0,0,1;[IN 1,1,0;GB 0,0,SX,SY;PR 4,3,'Btn'BP#!,0;][]"
A$=A$+"BU 2,90,60,64,14,1,0,2;[IN BP 2+,1,0;GB 0,0,SX,SY;PR 4,3,'P='BP#!,0;][SV 34,ZP;]"
A$=A$+"HSlider 3,16,80,120,8,10,20,100,5;[]"
A$=A$+"VSlider 4,150,60,8,60,2,5,30,1;[]"
A$=A$+"AList 5,170,60,12,4,7VA,1,0,0,7;[]"
A$=A$+"EDit 6,16,96,16,30,'Edit me',0,7;"
A$=A$+"DIgit 7,16,110,6,1234,1,0,7;"
A$=A$+"HText 8,180,100,20,4,39VA,0,1,0,7;[]"
A$=A$+"KY 27,0;"
A$=A$+"EXit;UI ZZ,2;[SV 29,P1 P2*;]"
Dialog Open 1,A$,40
Vdialog(1,7)=Array(V$(0))
Vdialog(1,39)=Varptr(T$)
R=Dialog Run(1) : Print #1,"run";Edialog
For I=0 To 6 : Print #1,Vdialog(1,I); : Next I : Print #1,""
For I=8 To 14 : Print #1,Vdialog(1,I); : Next I : Print #1,""
Print #1,Vdialog$(1,15);" ";Vdialog$(1,16);Vdialog(1,17);Vdialog(1,18);Vdialog(1,19);Vdialog(1,20)
For I=21 To 26 : Print #1,Vdialog(1,I); : Next I : Print #1,""
Print #1,Vdialog$(1,27);Vdialog(1,28);Vdialog(1,29);Vdialog(1,30);Vdialog(1,31);Vdialog(1,32);Vdialog(1,33);Vdialog(1,34)
Print #1,Rdialog(1,1);Rdialog(1,2);Rdialog(1,3);Rdialog(1,4);Rdialog(1,5);Rdialog$(1,6);Rdialog(1,7);Rdialog(1,8)
Print #1,Zdialog(1,40,72);Zdialog(1,120,76);Zdialog(1,5,5);Dialog(1)
Save Iff "AMOSTEST:out/dialog1_1.iff"
Dialog Update 1,2,2 : Dialog Update 1,3,50 : Dialog Update 1,4,10,10,40 : Dialog Update 1,5,2,3
Dialog Update 1,6,"New text" : Dialog Update 1,7,-55 : Dialog Update 1,8,1
Print #1,Rdialog(1,2);Vdialog(1,34);Rdialog(1,3);Rdialog(1,4);Rdialog(1,5);Rdialog$(1,6);Rdialog(1,7)
Save Iff "AMOSTEST:out/dialog1_2.iff"
Dialog Freeze 1 : Dialog Unfreeze 1 : Dialog Freeze : Dialog Unfreeze
Dialog Clr 1
Save Iff "AMOSTEST:out/dialog1_3.iff"
Print #1,Dialog(1);Rdialog(1,1)
Dialog Close 1
Dialog Open 2,"BA 0,0;SI 100,50;PR 1,1,'x',1;FOO 1;EX;"
Print #1,Edialog
Dialog Open 2,"SI 100,50;GB 10,10,5,5;EX;" : R=Dialog Run(2) : Print #1,Edialog
Dialog Open 2,"SI 100,50;EX;" : Dialog Open 2,"EX;"
Dialog Close 2 : Dialog Close 2
R=Dialog Run(9)
Print #1,Dialog Box("SI 64,32;BA 0,0;BO 0,0,1,SX,SY;RU 2,0;EX;",5,"x",10,10)
Dialog Open 3,"SI 64,32;LA 1;SV 0,11;EX;LA 2;SV 0,22;EX;"
R=Dialog Run(3,2) : Print #1,Vdialog(3,0) : R=Dialog Run(3,1) : Print #1,Vdialog(3,0)
R=Dialog Run(3,7)
Dialog Close
Print #1,"end"
