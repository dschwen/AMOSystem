Rem The options of the command line: --df0 path=label,ro --dh2 --assign --library (host only)
Print #1,"drive";Drive("df0:");Drive("df1:");Drive("Cli Disk:");Drive("dh2:");Drive("ALIAS:");Drive("Shelf:")
Print #1,"exist";Exist("df0:a.txt");Exist("ALIAS:b.txt");Exist("dh2:h.txt");Exist("Shelf:s.txt")
Trap Open Out 2,"Cli Disk:x" : Print #1,"ro";Errtrap
Print #1,Left$(Disc Info$("df0:"),9);"|";Left$(Disc Info$("dh2:"),5)
Print #1,"end"
