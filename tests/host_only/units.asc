Rem Units, labels, the library, write-protected disks (host only: docs/DEVICES.md)
Print #1,"drive";Drive("df0:");Drive("df1:");Drive("df2:");Drive("df3:");Drive("dh0:");Drive("dh3:");Drive("dh4:")
Print #1,"names";Drive("Big:");Drive("Game Disk 1:");Drive("GAME DISK 1:");Drive("DATA:");Drive("Nothere:");Drive("Shelf:")
Print #1,"exist";Exist("df0:a.txt");Exist("GAME DISK 1:A.TXT");Exist("df1:b.txt");Exist("dh3:h.txt");Exist("Big:h.txt");Exist("DATA:h.txt")
Print #1,"shelf";Exist("Shelf:s.txt");Exist("dh1:s.txt")
Print #1,Left$(Disc Info$("df0:"),12);"|";Left$(Disc Info$("dh3:"),4);"|";Left$(Disc Info$("df1:"),4);"|";Left$(Disc Info$("Shelf:"),6)
A$=Dev First$("DF*") : While A$<>"" : Print #1,"[";A$;"]" : A$=Dev Next$ : Wend
A$=Dev First$("DH*") : While A$<>"" : Print #1,"[";A$;"]" : A$=Dev Next$ : Wend
Open In 2,"df1:b.txt" : Line Input #2,B$ : Close 2 : Print #1,"read ";B$
Trap Open Out 2,"df1:new.txt" : Print #1,"create";Errtrap
Trap Kill "df1:b.txt" : Print #1,"kill";Errtrap
Trap Rename "df1:b.txt" To "df1:c.txt" : Print #1,"rename";Errtrap
Trap Mkdir "df1:d" : Print #1,"mkdir";Errtrap
Trap Open Out 2,"df0:new.txt" : Print #1,"df0 create";Errtrap
Print #2,"x" : Close 2
Trap Open In 2,"df2:x" : Print #1,"empty";Errtrap
Trap Open In 2,"df3:x" : Print #1,"none";Errtrap
Trap Open In 2,"df0:nothere.txt" : Print #1,"missing";Errtrap
Print #1,"end"
