Rem Extensions of other authors in the slots amos.conf names (host only): AMCAF in slot 9, Turbo Plus in slot 12
Print #1,"length";Amcaf Length
Print #1,"version";Amcaf Version$
Print #1,"base";Amcaf Base<>0
Print #1,"swap";Hex$(L Swap($12345678),8)
Print #1,"qsin";Qsin(1,100)
Print #1,"after";1
Print #1,"vmod";Vmod(5,1 To 3)
