Mkdir "Work:Sub"
Open Out 2,"Work:Sub/a.txt" : Print #2,"hello" : Close 2
Open Out 2,"RAM:r.txt" : Print #2,"ram" : Close 2
Open In 2,"work:SUB/A.TXT" : Input #2,A$ : Close 2 : Print #1,A$
Reserve As Work 10,1000 : Poke Start(10),65
Bsave "Work:Sub/b.bin",Start(10) To Start(10)+1000
Erase 10 : Reserve As Work 10,1000
Bload "Work:Sub/b.bin",Start(10) : Print #1,Peek(Start(10))
Poke Start(10),66 : Save "Work:Sub/bank.abk",10
Erase 10 : Load "Work:Sub/bank.abk",10 : Print #1,Peek(Start(10))
Print #1,Exist("Work:Sub/a.txt");Exist("Nothere:x");Exist("RAM:r.txt")
Print #1,Drive("Work:");Drive("RAM:");Drive("Nothere:")
A$=Dir First$("Work:Sub/") : While A$<>"" : Print #1,"[";A$;"]" : A$=Dir Next$ : Wend
A$=Dev First$("D*") : While A$<>"" : Print #1,"{";A$;"}" : A$=Dev Next$ : Wend
